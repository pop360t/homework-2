# >———IMPORTANT NOTE: USE A TERMINAL THAT SUPPORTS 24-BIT COLOUR RENDERING———<
def zoo_database(): animals = [input(f"Enter animal {i + 1}: ").strip().lower() for i in range(5)]; print("Animals:", animals); [print(f"There {'are' if animals.count(a) > 1 else 'is'} {animals.count(a)} {a}{'s' if animals.count(a) != 1 and not a.endswith('s') else ''}") for a in set(animals)] # Problem 1
# Puts a for loop in the list for conciseness ->------->------->------->------->^^^^^^^^^^^^^^^^^                                              ^^^^^^^^ Correct are/is checker ^^^^^^^^                        ^^^^^^^^ Checks if there's > 1, if so makes it plural ^^^^^^^^       ^<--- 'a' is an index variable to cycle through the list of animals ('a' also stands for animal); Uses set(animals) to make sure there are no duplicates
def convert_colour(): print("Convert RGB to hex (invalid inputs will be replaced with 255)"); red, green, blue = [(lambda x: int(x) if x.isdigit() and 0 <= int(x) <= 255 else 255)(input(n)) for n in ("Enter Red value from 0–255: ", "Enter Green value from 0–255: ", "Enter Blue value from 0–255: ")]; hex_value = f"{red:02X}{green:02X}{blue:02X}"; print(f"RGB(\033[38;2;{red};{green};{blue}m{red}, {green}, {blue}\033[0m) in hexadecimal colour code is \033[38;2;{red};{green};{blue}m#{hex_value}\033[0m, which is this colour: \033[48;2;{red};{green};{blue}m\n{"    " * 6}\033[0m") # Problem 2
#                                                                                             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^Asks for red, green, and blue values and uses lambda to replace invalid inputs with 255^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^                                                  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^   ^^^^^^^^^^^^^^^^^^^^^^ Prints the final output with colours ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
#                                                                                                                                                                                                                                                   The '02X' strips the '0x' from the hex number and makes letters uppercase (or lowercase if preferred)--->^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
if __name__ == "__main__": zoo_database(), convert_colour() # Runs the program
